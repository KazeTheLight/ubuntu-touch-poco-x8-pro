# Poco X8 Pro (klee) additions on top of gki_defconfig + halium.config
# (keep empty unless strictly needed: every change risks breaking the GKI KMI)

# LK concatenates the init_boot ramdisk and the vendor_boot ramdisk into one
# initrd. Both stock Android ramdisks on klee are legacy-LZ4, and so is the
# Halium initramfs, but the UT kernel was built without CONFIG_RD_LZ4, so the
# kernel could not unpack any of it:
#
#   Trying to unpack rootfs image as initramfs...
#   rootfs image is not initramfs (no cpio magic); looks like an initrd
#   Run /init as init process        <- Android's init from vendor_boot
#   init: mount("selinuxfs", ...) failed
#   init: InitFatalReboot: signal 6
#   reboot: Restarting system with command 'bootloader'
#
# (gzip initramfs was detected but failed with "Decoding failed", which proves
#  CONFIG_RD_GZIP is on and CONFIG_RD_LZ4 was the missing one.)
CONFIG_RD_LZ4=y

# --- storage: the UT kernel is a generic GKI build and ships no MediaTek UFS
# glue, so the initramfs waited forever for /dev/disk/by-partlabel/super:
#   initrd: waiting for /dev/disk/by-partlabel/super
# The stock Android boot works because its vendor kernel has these drivers.
# Build them as modules and load them from the UT vendor ramdisk (see
# port/vendor-ramdisk-overlay/lib/modules/modules.load).
CONFIG_ARCH_MEDIATEK=y
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFSHCD_PLATFORM=m
CONFIG_SCSI_UFS_MEDIATEK=m
CONFIG_PHY_MTK_UFS=m
CONFIG_RESET_TI_SYSCON=m
